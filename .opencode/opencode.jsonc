{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "bash": {
      "git *": "allow",
      "mkdir *": "allow",
      "pip install *": "allow",
      "npm install *": "allow",
      "npx *": "ask",
      "ffmpeg *": "allow",
      "*": "ask",
    },
    "edit": "allow",
    "external_directory": {
      "/Users/vophamnhuthao/Work/SubTitleExtractor/**": "allow",
      "*": "ask",
    },
  },

  "mcp": {
    "react-devtools": {
      "type": "local",
      "command": ["npx", "-y", "@ferryhinardi/react-devtools-mcp"],
      "enabled": true,
      "description": "Inspect React component tree, props, state, hooks trong Chrome — dùng khi debug frontend, kiểm tra component hierarchy",
    },
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "enabled": true,
      "description": "Next.js official MCP — query routes, detect errors, tra cứu Next.js docs, hỗ trợ upgrade/migration. Runtime diagnostics cần Next.js 16+, docs & tools work với mọi version.",
    },
  },
}
